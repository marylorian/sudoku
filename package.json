{
  "name": "sudoku-levels",
  "version": "1.0.0",
  "private": true,
  "main": "main.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 3000",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "expo export --platform web --output-dir dist",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "node scripts/run-e2e.mjs",
    "eas": "eas",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:stores": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android --profile production --latest",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "submit:stores": "npm run submit:android && npm run submit:ios",
    "publish:android": "npm run build:android && npm run submit:android",
    "publish:ios": "npm run build:ios && npm run submit:ios",
    "publish:stores": "npm run publish:android && npm run publish:ios",
    "prepare": "husky install"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "expo": "^57.0.9",
    "expo-splash-screen": "^0.26.5",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.4.5",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.45",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "cypress": "^13.8.1",
    "eas-cli": "^19.0.5",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-expo": "^50.0.4",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{js,json,md,mjs,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@react-native/babel-plugin-codegen": "0.73.4",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/codegen": "0.73.3"
  }
}
