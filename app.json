{
  "expo": {
    "name": "Sudoku Levels",
    "slug": "sudoku",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sudokulevels",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "backgroundColor": "#f8fafc",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.sudokulevels"
    },
    "android": {
      "package": "com.example.sudokulevels",
      "splash": {
        "backgroundColor": "#f8fafc",
        "resizeMode": "contain"
      },
      "adaptiveIcon": {
        "backgroundColor": "#f8fafc"
      }
    },
    "web": {
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "7d548e7a-47a8-489b-9420-bd627147c5c2"
      }
    },
    "owner": "marylorians-organization"
  }
}
